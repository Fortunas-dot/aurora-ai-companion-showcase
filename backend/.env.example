# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/aurora
JWT_SECRET=
FRONTEND_URL=
BASE_URL=
API_URL=

# AI providers (at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Aurora

# Video uploads (Cloudflare Stream, optional)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Sign-in (optional)
GOOGLE_OAUTH_CLIENT_IDS=
FACEBOOK_APP_ID=

# Ops
ADMIN_PRESENCE_TOKEN=
AI_LOAD_TEST_MODE=false

# Local seeding only
SEED_PASSWORD=
PRESERVE_ACCOUNT_EMAIL=
